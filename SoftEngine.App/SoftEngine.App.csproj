<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoftEngine.Core\SoftEngine.Core.csproj" />
  </ItemGroup>

  <!-- Windows: drop SDL2.dll (x64, from the SDL2 release zip) next to this .csproj and it gets copied. -->
  <ItemGroup>
    <None Include="SDL2.dll" Condition="Exists('SDL2.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
